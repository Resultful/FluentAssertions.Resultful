<Project Sdk="Microsoft.NET.Sdk">
  <!-- Legacy flavor: compiles src/Resultful.AwesomeAssertions.OneOf against FluentAssertions 7.x. Add nothing here; change the shared sources. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <Description>FluentAssertions 7.x build of Resultful.AwesomeAssertions.OneOf: assert which case a OneOf (1-8 cases) holds. New projects should use Resultful.AwesomeAssertions.OneOf with AwesomeAssertions.</Description>
    <SharedSource>$(MSBuildThisFileDirectory)../../../src/Resultful.AwesomeAssertions.OneOf</SharedSource>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluentAssertions.Union\FluentAssertions.Union.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OneOf" />
  </ItemGroup>
</Project>
