    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <Description>Extension to FluentAssertions which improves the usage of OneOf.Extended (9-32 type overloads) to allow easier unit testing.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluentAssertions.OneOf\FluentAssertions.OneOf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="OneOf.Extended" />
  </ItemGroup>
</Project>
