<Project Sdk="Microsoft.NET.Sdk">
  <!-- Legacy flavor: compiles tests/Resultful.AwesomeAssertions.Tests against FluentAssertions 7.x. Add nothing here; change the shared sources. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SharedSource>$(MSBuildThisFileDirectory)../../../tests/Resultful.AwesomeAssertions.Tests</SharedSource>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FluentAssertions.Resultful\FluentAssertions.Resultful.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NunitXml.TestLogger" />
    <PackageReference Include="Resultful" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="$(AssertionsFlavor).Extensions" />
    <Using Include="$(ResultNamespace)" />
  </ItemGroup>
</Project>
