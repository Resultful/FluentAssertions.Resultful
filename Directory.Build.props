<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CA1716;CA1000;CA1510;NU5104</NoWarn>
  </PropertyGroup>

  <!--
    Every project builds against one assertion library, its flavor. AwesomeAssertions is the default; projects under
    legacy/ set FluentAssertions before importing this file, and compile the same sources with FLUENTASSERTIONS defined.
    The namespaces below are also the assembly and package names.
  -->
  <PropertyGroup>
    <AssertionsFlavor Condition="'$(AssertionsFlavor)' == ''">AwesomeAssertions</AssertionsFlavor>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AssertionsFlavor)' == 'AwesomeAssertions'">
    <UnionNamespace>Resultful.AwesomeAssertions.Union</UnionNamespace>
    <OneOfNamespace>Resultful.AwesomeAssertions.OneOf</OneOfNamespace>
    <OneOfExtendedNamespace>Resultful.AwesomeAssertions.OneOf.Extended</OneOfExtendedNamespace>
    <ResultNamespace>Resultful.AwesomeAssertions</ResultNamespace>
    <AssertionContextType>AwesomeAssertions.Execution.AssertionChain</AssertionContextType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AssertionsFlavor)' == 'FluentAssertions'">
    <DefineConstants>$(DefineConstants);FLUENTASSERTIONS</DefineConstants>
    <UnionNamespace>FluentAssertions.Union</UnionNamespace>
    <OneOfNamespace>FluentAssertions.OneOf</OneOfNamespace>
    <OneOfExtendedNamespace>FluentAssertions.OneOf.Extended</OneOfExtendedNamespace>
    <ResultNamespace>FluentAssertions.Resultful</ResultNamespace>
    <AssertionContextType>FluentAssertions.Execution.AssertionScope</AssertionContextType>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Ryan Kelly</Authors>
    <PackageProjectUrl>https://github.com/Resultful/FluentAssertions.Resultful</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Resultful/FluentAssertions.Resultful.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName.EndsWith(&quot;Examples&quot;))' or '$(MSBuildProjectName.EndsWith(&quot;Tests&quot;))'">
    <NoWarn>$(NoWarn);CA1305;CA1822;CA1062;CA1707;CA1852</NoWarn>
  </PropertyGroup>
</Project>
